{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Assets-only Worker: there is no `main` script, so every request is answered
	// straight from static assets (the `next build` static export in out/). Static
	// asset requests are free, unlimited, and never count against Worker CPU time.
	"name": "financial-hub",
	"compatibility_date": "2026-05-22",
	"assets": {
		"directory": "./out",
		// /calculators/mortgage serves calculators/mortgage.html; a trailing-slash
		// variant redirects to the slashless canonical.
		"html_handling": "auto-trailing-slash",
		// Unknown paths get out/404.html with a 404 status.
		"not_found_handling": "404-page"
	}
}
